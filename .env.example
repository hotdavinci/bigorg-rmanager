APP_ENCRYPTION_KEY=
META_APP_ID=
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_APP_SECRET=
META_REDIRECT_URI=https://seu-projeto.vercel.app/api/meta/callback
META_GRAPH_API_VERSION=
META_OAUTH_AUTHORIZE_URL=https://www.facebook.com/v{version}/dialog/oauth
META_OAUTH_TOKEN_URL=https://graph.facebook.com/v{version}/oauth/access_token
META_GRAPH_BASE_URL=https://graph.facebook.com/v{version}
ADMIN_EMAIL=hotdavinci@gmail.com
ADMIN_PASSWORD=
CAMPAIGN_COVER_PATH=
PYTHON_EXECUTABLE=python
PROCESSING_TIMEOUT_SECONDS=1800
# Painel hospedado que pode chamar a API da VPS. Separe m\u00faltiplas origens por v\u00edrgula.
CORS_ALLOWED_ORIGINS=https://seu-projeto.vercel.app
# Ative somente quando a API estiver publicada em HTTPS.
SESSION_HTTPS_ONLY=true
# Endere\u00e7o fixo do media.bigorg-rmanager-vps.tech, depois de criar o Tunnel nomeado.
PUBLIC_MEDIA_BASE_URL=
# Opcional: proxy HTTP/HTTPS somente para criar container e publicar Reel.
# Exemplo sintético: http://usuario:senha@proxy.example:8080
# Vazio = publicação direta. Não versionar credenciais reais.
META_PUBLISH_PROXY_URL=
# Lista JSON opcional, com prioridade sobre o proxy único. Somente exemplos.
# META_PUBLISH_PROXY_URLS='["http://usuario:senha@proxy.example:8080"]'
META_PUBLISH_PROXY_URLS=
# Legado: ignorado. Agora cada conta recebe um proxy fixo e persistente.
META_PUBLISH_PROXY_POSTS_PER_PROXY=10
